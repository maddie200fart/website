<style>
:root{
  --bg:#f6f1e7; --bg2:#ece5d6; --sage:#c9d2bf; --sage-d:#8c9b83; --forest:#27412f; --forest-d:#1d3124;
  --ink:#2b3a2f; --muted:#5b665c; --oat:#d9ccb4; --taupe:#a39580; --blush:#e6cfc6; --card:#fbf8f1; --line:#d8cfbd;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  --serif:"Cormorant Garamond",Georgia,"Times New Roman",serif; --sans:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#1c2a20;--bg2:#223327;--sage:#34493a;--sage-d:#9fb095;--forest:#d8e2cd;--forest-d:#142019;--ink:#ece6d8;--muted:#b9c1b2;--oat:#3b4a3d;--taupe:#b8a98f;--blush:#4a3a38;--card:#243529;--line:#3a4c3e}
}
:root[data-theme="dark"]{--bg:#1c2a20;--bg2:#223327;--sage:#34493a;--sage-d:#9fb095;--forest:#d8e2cd;--forest-d:#142019;--ink:#ece6d8;--muted:#b9c1b2;--oat:#3b4a3d;--taupe:#b8a98f;--blush:#4a3a38;--card:#243529;--line:#3a4c3e}
html{scroll-behavior:smooth;scroll-padding-top:5rem}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.7 var(--sans);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--forest);line-height:1.1;margin:0}
h1{font-size:clamp(2.8rem,7vw,5.2rem);letter-spacing:-.01em}
h2{font-size:clamp(2.1rem,4.4vw,3.2rem)}
h3{font-size:1.65rem}
p{margin:0 0 1rem;max-width:62ch}
a{color:inherit}
:focus-visible{outline:3px solid var(--forest);outline-offset:3px;border-radius:4px}
.wrap{max-width:1160px;margin:0 auto;padding:0 1.5rem}
.sr{position:absolute;left:-999px}
.sr:focus{left:1rem;top:1rem;background:var(--card);padding:.5rem 1rem;z-index:50}

/* header */
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;height:4.5rem;gap:1rem}
.brand{font-family:var(--serif);font-size:1.45rem;font-weight:600;color:var(--forest);text-decoration:none;display:flex;align-items:center;gap:.6rem;line-height:1}
.brand svg{width:26px;height:26px;color:var(--forest)}
nav ul{display:flex;gap:2rem;list-style:none;margin:0;padding:0;align-items:center}
nav a{text-decoration:none;font-size:.97rem;font-weight:500;color:var(--ink);padding:.3rem 0;background:linear-gradient(var(--forest),var(--forest)) 0 100%/0 1.5px no-repeat;transition:background-size .3s}
nav a:hover{background-size:100% 1.5px}
.btn{display:inline-block;background:var(--forest);color:var(--bg);text-decoration:none;font-weight:600;font-size:.97rem;padding:.85rem 1.7rem;border-radius:999px;border:1.5px solid var(--forest);transition:background .25s,color .25s,transform .25s;cursor:pointer;font-family:var(--sans)}
.btn:hover{background:transparent;color:var(--forest);transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--forest)}
.btn.ghost:hover{background:var(--forest);color:var(--bg)}
nav .btn{padding:.6rem 1.3rem}
nav .btn:hover{background-size:0}
.menu{display:none;background:none;border:1.5px solid var(--forest);color:var(--forest);border-radius:999px;padding:.5rem 1rem;font:600 .95rem var(--sans);cursor:pointer}

/* hero */
.hero{padding:clamp(2.5rem,6vw,5rem) 0 clamp(3rem,7vw,6rem)}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,5rem);align-items:center}
.hero p.lead{font-size:1.2rem;color:var(--muted);margin:1.6rem 0 2rem}
.hero h1 em{font-style:italic;font-weight:400}
.cta{display:flex;gap:1rem;flex-wrap:wrap}
.arch{position:relative;aspect-ratio:4/5;border-radius:999px 999px 1.2rem 1.2rem;background:linear-gradient(180deg,var(--sage),var(--oat));overflow:hidden;display:grid;place-items:end center}
.arch .leafy{position:absolute;inset:0;color:var(--forest);opacity:.85}
.ph{position:absolute;left:50%;bottom:1.2rem;transform:translateX(-50%);background:var(--card);color:var(--muted);font-size:.82rem;padding:.35rem .9rem;border-radius:999px;white-space:nowrap;border:1px dashed var(--taupe)}
.blush-dot{position:absolute;right:-2rem;top:3rem;width:9rem;height:9rem;border-radius:50%;background:var(--blush);opacity:.7;z-index:-1}
.hero .art{position:relative;isolation:isolate}

/* sections */
section{padding:clamp(3.5rem,8vw,6.5rem) 0}
.alt{background:var(--bg2)}
.intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,6vw,5rem);align-items:start}
.intro p:first-of-type{font-family:var(--serif);font-size:1.7rem;line-height:1.35;color:var(--forest)}
.head{max-width:40rem;margin-bottom:3rem}
.svc{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}
.svc article{padding:2rem 2rem 2.2rem 0;border-bottom:1px solid var(--line);position:relative}
.svc article:not(:nth-child(3n)){border-right:1px solid var(--line);padding-right:2rem}
.svc article:not(:nth-child(3n+1)){padding-left:2rem}
.svc svg{width:34px;height:34px;color:var(--sage-d);margin-bottom:1rem}
.svc p{color:var(--muted);font-size:1rem}
.fill{background:var(--blush);color:var(--ink);padding:.05rem .45rem;border-radius:4px;font-size:.92em}
.about{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,6vw,5rem);align-items:center}
.portrait{position:relative;aspect-ratio:1/1.1;border-radius:1.2rem 1.2rem 999px 999px;background:linear-gradient(160deg,var(--oat),var(--sage));overflow:hidden}
.portrait .leafy{position:absolute;inset:0;color:var(--forest);opacity:.7}
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;counter-reset:s}
.steps li{counter-increment:s;position:relative;padding-top:4rem}
.steps li::before{content:counter(s);position:absolute;top:0;left:0;width:2.8rem;height:2.8rem;border-radius:50%;background:var(--forest);color:var(--bg);display:grid;place-items:center;font-family:var(--serif);font-size:1.5rem}
.steps li:not(:last-child)::after{content:"";position:absolute;top:1.4rem;left:3.6rem;right:-1.5rem;border-top:1.5px dashed var(--taupe)}
.steps p{color:var(--muted);font-size:1rem}
.contact{background:var(--forest-d);color:#efe9da;position:relative;overflow:hidden}
.contact h2{color:#f3eee0}
.contact .grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,5rem);align-items:center;position:relative;z-index:1}
.contact .btn{background:#efe9da;color:#1d3124;border-color:#efe9da}
.contact .btn:hover{background:transparent;color:#efe9da}
.contact dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.9rem 1.5rem}
.contact dt{color:#b7c4aa;font-weight:500}
.contact dd{margin:0}
.contact .fill{background:#4a3a38;color:#f3e6df}
.contact .leafy{position:absolute;right:-60px;bottom:-40px;width:340px;color:#8c9b83;opacity:.25}
footer{background:#142019;color:#cfd6c5;padding:3rem 0 2.5rem;font-size:.95rem}
footer .row{display:flex;justify-content:space-between;gap:2rem;flex-wrap:wrap}
footer ul{list-style:none;margin:0;padding:0;display:flex;gap:1.5rem;flex-wrap:wrap}
footer a{text-decoration:none;border-bottom:1px solid transparent}
footer a:hover{border-color:currentColor}
footer .fill{background:#4a3a38;color:#f3e6df}
footer small{display:block;margin-top:2rem;color:#9aa890;max-width:70ch}
.note{background:var(--blush);color:var(--ink);font-size:.9rem;padding:.6rem 1.5rem;text-align:center}
.note p{margin:0 auto;max-width:none}

/* one orchestrated load moment */
@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.hero .wrap>div:first-child>*{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
.hero .wrap>div:first-child>*:nth-child(2){animation-delay:.12s}
.hero .wrap>div:first-child>*:nth-child(3){animation-delay:.24s}
.arch .leafy path.s{stroke-dasharray:400;stroke-dashoffset:400;animation:draw 2.4s .3s ease-out forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto}.arch .leafy path.s{stroke-dashoffset:0}}

@media (max-width:900px){
  .menu{display:block}
  nav{position:absolute;left:0;right:0;top:4.5rem;background:var(--bg);border-bottom:1px solid var(--line);display:none;padding:1rem 1.5rem 1.5rem}
  nav.open{display:block}
  nav ul{flex-direction:column;align-items:flex-start;gap:1rem}
  .hero .wrap,.intro,.about,.contact .grid{grid-template-columns:1fr}
  .arch{max-width:420px;margin:0 auto;width:100%}
  .svc{grid-template-columns:1fr}
  .svc article,.svc article:not(:nth-child(3n)),.svc article:not(:nth-child(3n+1)){border-right:0;padding:1.6rem 0}
  .steps{grid-template-columns:1fr;gap:2rem}
  .steps li:not(:last-child)::after{display:none}
  .portrait{max-width:380px}
}

