.when li{break-inside:avoid;padding:.55rem 0 .55rem 1.6rem;position:relative;color:var(--muted);font-size:1rem}
.when li::before{content:"";position:absolute;left:0;top:1.05rem;width:.7rem;height:.7rem;border-radius:0 100% 0 100%;background:var(--sage-d)}
.when b{color:var(--ink);font-weight:600}
.walk{background:var(--sage);color:var(--forest-d)}
:root[data-theme="dark"] .walk,.walk{--wk:var(--ink)}
.walk .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,6vw,5rem);align-items:center}
.walk h2{color:var(--forest)}
.walk .towns{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.2rem 0 0;padding:0;list-style:none}
.walk .towns li{border:1.5px solid var(--forest);color:var(--forest);padding:.3rem .95rem;border-radius:999px;font-size:.93rem;font-weight:500}
.walk .path{aspect-ratio:1/1;border-radius:1.2rem;background:var(--bg);position:relative;overflow:hidden;display:grid;place-items:center}
.walk .path svg{width:80%;color:var(--forest)}
.fees{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem)}
.fees dl{margin:0}.fees dt{font-family:var(--serif);font-size:1.5rem;color:var(--forest);margin-top:1.6rem}.fees dt:first-child{margin-top:0}
.fees dd{margin:.2rem 0 0;color:var(--muted)}
.price{display:flex;gap:2.5rem;flex-wrap:wrap;margin-bottom:1.5rem}
.price div{font-family:var(--serif);font-size:3rem;color:var(--forest);line-height:1}
.price span{display:block;font:400 .95rem var(--sans);color:var(--muted);margin-top:.4rem}
.band{padding:2.5rem 0;background:var(--blush);color:var(--ink)}
.band p{font-family:var(--serif);font-size:clamp(1.4rem,2.6vw,1.9rem);line-height:1.35;max-width:52rem;margin:0 auto;text-align:center;color:var(--forest-d)}
:root[data-theme="dark"] .band p{color:var(--ink)}
.res{margin-top:2rem;padding-top:1.5rem;border-top:1px solid #31453a;font-size:.92rem}
.res ul{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:.5rem 2rem}
.res a{border-bottom:1px solid #5d6f5f}
.pic{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.has .ph{display:none}.dog{font-size:.88rem;color:var(--muted);margin-top:.8rem}
@media (max-width:900px){.when{columns:1}.walk .wrap,.fees{grid-template-columns:1fr}.walk .path{max-width:360px}}
</style>
</head>
